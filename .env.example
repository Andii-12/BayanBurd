# Copy to apps/api/.env and apps/web/.env.local

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bayan_burd_eternity

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# File storage: Cloudflare R2
# Buckets already created: issueimages, productimages
# 1. Open EACH bucket → Settings → Public Development URL → Enable
# 2. Copy each Public Bucket URL (https://pub-xxxx.r2.dev)
# 3. R2 overview → Manage R2 API Tokens → Create API token
#    Permission: Object Read & Write, apply to issueimages + productimages
# 4. Copy Access Key ID, Secret Access Key, and Account ID
STORAGE_DRIVER=r2
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET_ISSUES=issueimages
STORAGE_BUCKET_PRODUCTS=productimages
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL_ISSUES=https://pub-xxxxxxxx.r2.dev
STORAGE_PUBLIC_URL_PRODUCTS=https://pub-yyyyyyyy.r2.dev
UPLOAD_MAX_MB=15

# Email via Resend (https://resend.com/api-keys)
# Test from: Bayan Burd Eternity <onboarding@resend.dev> — only sends to your Resend account email
# Production: verify a domain in Resend and set RESEND_FROM to that domain
RESEND_API_KEY=
RESEND_DOMAIN=service.bb-eternity.mn
RESEND_FROM=Bayan Burd Eternity <noreply@service.bb-eternity.mn>

# Optional SMTP fallback if RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bayan Burd Eternity <noreply@eternity.mn>

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Bayan Burd Eternity
