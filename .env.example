# Copy to apps/api/.env and apps/web/.env.local

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bayan_burd_eternity

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# File storage: "local" | "r2"
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
UPLOAD_MAX_MB=15

# Email (leave empty to log emails in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bayan Burd Eternity <noreply@eternity.mn>

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Bayan Burd Eternity
